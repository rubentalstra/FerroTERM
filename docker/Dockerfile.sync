# syntax=docker/dockerfile:1
# The FerroTERM sync image: the synchronisation service and the offline index
# builder, two static binaries on distroless static, per platform. The service
# runs `ferroterm-build` as a subprocess, which is why both live here.
#
# The binaries are not built here, the same way docker/Dockerfile takes the
# server: a release lane builds and attests them in the SLSA L3 lane and stages
# them under dist/<os>/<arch>/ before this file is built.
#
# Build locally from a staged dist/ tree, from the repository root:
#   docker buildx build -f docker/Dockerfile.sync --platform linux/arm64 .

# distroless static: ca-certificates, tzdata, /etc/passwd with the nonroot
# user (uid 65532), a /tmp, no shell, no package manager, about 2 MiB. Pinned
# by index digest, the same digest docker/Dockerfile pins; Dependabot (docker
# ecosystem) proposes the bumps.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

# The platform of the manifest being built, set by buildx per platform.
ARG TARGETOS
ARG TARGETARCH

# Root-owned and not writable by the runtime user. The service is the
# entrypoint; the builder is the subprocess the RF2 lane runs.
COPY --chmod=0555 dist/${TARGETOS}/${TARGETARCH}/ferroterm-sync /usr/local/bin/ferroterm-sync
COPY --chmod=0555 dist/${TARGETOS}/${TARGETARCH}/ferroterm-build /usr/local/bin/ferroterm-build

# The admin listener carries the manual triggers, the run records, and the
# metrics. Its default address is loopback, which no container can publish, so
# the image default is every interface on the documented port. Keep it on an
# internal network: it authenticates nobody.
EXPOSE 8181/tcp

# Numeric on purpose: the kubelet cannot resolve a user name against an image
# it does not read, so `runAsNonRoot: true` refuses a named USER. The volumes
# the service writes (the staging, records, and state directories) must be
# writable by this uid.
USER 65532:65532

# The base has no shell and no HTTP client, so the probe is the binary itself:
# one GET /health on the admin listener the configuration names, exit 0 on 200.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/ferroterm-sync", "healthcheck"]

# Exec form: the binary is PID 1 and receives SIGTERM itself (there is no
# shell to forward it); it stops gracefully on SIGTERM and SIGINT. The
# configuration file defaults to /etc/ferroterm/sync.toml; mount one there, or
# pass `--config`.
ENTRYPOINT ["/usr/local/bin/ferroterm-sync"]

# Build-independent OCI labels; a release lane adds the build-dependent ones
# (version, revision, created) and mirrors every label as an index annotation.
LABEL org.opencontainers.image.title="FerroTERM sync" \
      org.opencontainers.image.description="The FerroTERM synchronisation service: one way from a terminology syndication feed into a running FerroTERM" \
      org.opencontainers.image.url="https://ferroterm.eu" \
      org.opencontainers.image.documentation="https://ferroterm.eu/docs/" \
      org.opencontainers.image.source="https://github.com/rubentalstra/FerroTERM" \
      org.opencontainers.image.vendor="FerroTERM" \
      org.opencontainers.image.licenses="BUSL-1.1" \
      org.opencontainers.image.base.name="gcr.io/distroless/static-debian13:nonroot"
